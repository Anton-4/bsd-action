{
  "name": "cross-platform-action",
  "version": "0.0.1",
  "private": true,
  "description": "Cross platform GitHub action",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint 'src/**/*.ts'",
    "package": "npm run package:main && npm run package:post",
    "package:main": "ncc build --source-map --license licenses.txt",
    "package:post": "cp post/main.mjs dist/post.mjs",
    "test": "./bin/node ./node_modules/jasmine/bin/jasmine.js",
    "update-digests": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON bin/update_digests.mjs",
    "check-digests": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON bin/update_digests.mjs --check",
    "all": "npm run build && npm run format && npm run lint && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cross-platform-actions/action.git"
  },
  "keywords": [
    "actions",
    "cross",
    "platfrom",
    "cross platfrom",
    "cross-platform"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.2.6",
    "@actions/exec": "^1.0.4",
    "@actions/tool-cache": "^1.6.0"
  },
  "devDependencies": {
    "@types/jasmine": "^6.0.0",
    "@types/node": "^14.14.9",
    "@typescript-eslint/eslint-plugin": "5.37.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/ncc": "^0.36.1",
    "eslint": "^8.23.1",
    "eslint-plugin-github": "^4.3.7",
    "eslint-plugin-jasmine": "^4.2.2",
    "jasmine": "^6.2.0",
    "prettier": "2.4.1",
    "ts-node": "^10.9.1",
    "typescript": "^4.4.3"
  }
}
